# ─────────────────────────────────────────────────────────────────────────────
# Donat — environment configuration. Copy to `.env` (never commit `.env`).
# Values below are safe LOCAL DEVELOPMENT defaults.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──
PORT=4000
# Public URL of the web app (used in emails and payment return URLs)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy" setting: loopback | true | false | number of hops | CIDR list
TRUST_PROXY=loopback

# ── Database (PostgreSQL) ──
# Local: `npm run db:start` runs an embedded PostgreSQL on port 5433 with these credentials.
DATABASE_URL=postgresql://donat:donat@localhost:5433/donat?schema=public

# ── Redis (optional locally) ──
# When unset, an in-memory queue + rate limiter are used (single process only).
# Production: set it and run the worker (`npm run start:worker`).
REDIS_URL=
RUN_WORKER_IN_PROCESS=true
SCHEDULER_ENABLED=true

# ── Auth ──
# REQUIRED in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=donat-api
JWT_AUDIENCE=donat-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true behind HTTPS (production)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Store ──
STORE_CURRENCY=USD
ORDER_PAYMENT_TTL_MINUTES=30
FULFILLMENT_MAX_ATTEMPTS=3
RECONCILE_MAX_CHECKS=5

# ── Payments ──
# Real-money payments are DISABLED by default. Only enable after an official gateway
# integration has been implemented, reviewed and tested in the gateway's sandbox.
ENABLE_REAL_PAYMENTS=false
ENABLE_MOCK_PAYMENTS=true
# Secret used to sign mock gateway webhooks (min 16 chars). Set a random value in production
# if you ever leave mock payments enabled (you should not).
MOCK_PAYMENT_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# ── Fulfillment ──
# Real game-currency delivery is DISABLED by default. It also requires an authorized provider
# record, a registered adapter written from official supplier docs, and credentials.
ENABLE_REAL_FULFILLMENT=false
# Credentials for an authorized supplier are read from <PREFIX>_<NAME> variables, e.g.
# SUPPLIERX_API_KEY=...   (the prefix is configured on the provider in the admin panel)

# ── Uploads ──
# UPLOAD_DIR=/var/lib/donat/uploads
MAX_UPLOAD_BYTES=2097152

# ── Rate limiting ──
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info

# ── Seed ──
SEED_ADMIN_EMAIL=admin@donat.local
# Required when seeding production
SEED_ADMIN_PASSWORD=

# ── Web (Next.js) ──
# Where the Next.js server proxies /api and /uploads (server-side only, never exposed)
API_INTERNAL_URL=http://localhost:4000
