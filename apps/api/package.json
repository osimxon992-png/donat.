{
  "name": "@donat/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@donat/shared": "*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.58.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "jose": "6.1.0",
    "multer": "2.0.2",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "17.6.0-beta.15",
    "pino-pretty": "13.1.1",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "vitest": "3.2.7"
  }
}
